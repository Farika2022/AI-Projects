# Copy this file to .env (for `vercel dev`) and fill in the values you have.
# Nothing here is required to run the app — every AI feature degrades
# gracefully to "off" if its key is missing. See README.md > "Claude API
# integration" for details.

# Black Forest Labs (FLUX image generation). Required for the actual
# redesign/inpainting feature to produce images.
BFL_API_KEY= bfl_P9wRJZfSzqBM2HajRij7eEv2BBAP9SXI

# Anthropic Claude API. Optional. When set, the app uses Claude to (1)
# rewrite raw user requests into clearer FLUX prompts before generation, and
# (2) review each generated image against the request afterwards. When this
# is unset, invalid, or out of credit, those two steps are silently skipped
# and the app behaves exactly like the FLUX-only version — no errors, no
# broken UI, just no "Claude rewrote your prompt" panel or quality badges.
ANTHROPIC_API_KEY=

# Optional. Overrides which Claude model the two Claude features use.
# Defaults to a fast, inexpensive model (claude-haiku-4-5-20251001) — plenty
# for short prompt rewrites and single-image quality checks.
CLAUDE_MODEL=claude-haiku-4-5-20251001
